// DiaAgent v2 — dùng database Neo4j riêng cho Project 01.
// Chạy được bằng cypher-shell -f data/DB_diabet.cypher
CREATE CONSTRAINT p1_passage_id IF NOT EXISTS FOR (p:P1Passage) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT p1_topic_name IF NOT EXISTS FOR (p:P1Topic) REQUIRE p.name IS UNIQUE;
CREATE CONSTRAINT p1_source_url IF NOT EXISTS FOR (p:P1Source) REQUIRE p.url IS UNIQUE;
CREATE CONSTRAINT p1_concept_name IF NOT EXISTS FOR (p:P1Concept) REQUIRE p.name IS UNIQUE;

UNWIND [{`id`: "K01", `topic`: "Cấp cứu", `title`: "Dấu hiệu nhiễm toan ceton", `keys`: "khó thở nôn liên tục hơi thở trái cây ketone cấp cứu", `url`: "https://www.cdc.gov/diabetes/about/diabetic-ketoacidosis.html", `text`: "Khó thở, nôn đến mức không giữ được thức ăn hoặc nước uống, và hơi thở mùi trái cây có thể là dấu hiệu cần cấp cứu khi nghi nhiễm toan ceton.", `source`: "CDC"}, {`id`: "K02", `topic`: "Xét nghiệm", `title`: "HbA1c phản ánh đường huyết trong bao lâu?", `text`: "HbA1c phản ánh mức đường huyết trung bình trong khoảng hai đến ba tháng gần đây. Xét nghiệm hỗ trợ phát hiện và theo dõi đái tháo đường.", `keys`: "HbA1c a1c hemoglobin glycat", `url`: "https://nhathuoclongchau.com.vn/bai-viet/chi-so-hb-a1c-binh-thuong-la-bao-nhieu-khi-nao-nen-lam-xet-nghiem-hb-a1-c.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K03", `topic`: "Xét nghiệm", `title`: "Nghiệm pháp dung nạp glucose đường uống", `text`: "OGTT đo đường huyết theo quy trình chuẩn sau khi uống dung dịch glucose. Một lần đo tại nhà sau bữa ăn thông thường không thay thế được xét nghiệm này.", `keys`: "ogtt nghiệm pháp dung nạp đường dung nạp glucose đường huyết hai giờ", `url`: "https://nhathuoclongchau.com.vn/bai-viet/chi-so-duong-huyet-tien-tieu-duong-la-bao-nhieu.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K04", `topic`: "Xét nghiệm", `title`: "Đo glucose lúc đói", `text`: "Đo glucose lúc đói là xét nghiệm máu sau thời gian nhịn ăn theo hướng dẫn của cơ sở y tế. Thời điểm đo cần được xác định trước khi đối chiếu kết quả với ngưỡng lúc đói.", `keys`: "đường huyết lúc đói glucose lúc đói nhịn ăn", `url`: "https://nhathuoclongchau.com.vn/bai-viet/huong-dan-cach-doc-chi-so-duong-huyet-chinh-xac-va-don-gian-nhat.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K05", `topic`: "Theo dõi", `title`: "Dấu hiệu thường gặp của đái tháo đường", `text`: "Khát nhiều, tiểu nhiều và nhìn mờ là những dấu hiệu có thể gặp. Một số người có biểu hiện không rõ; cần xét nghiệm để xác định nguyên nhân.", `keys`: "triệu chứng tiểu nhiều khát nhiều nhìn mờ", `url`: "https://nhathuoclongchau.com.vn/bai-viet/nhan-biet-ve-trieu-chung-benh-tieu-duong-giai-doan-dau.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K06", `topic`: "Vận động", `title`: "Vận động và phòng ngừa típ 2", `text`: "Tập thể dục đều đặn là một phần của lối sống giúp giảm nguy cơ đái tháo đường típ 2. Chọn hoạt động phù hợp với khả năng và tình trạng sức khỏe.", `keys`: "vận động đi bộ hoạt động thể lực tập thể dục", `url`: "https://nhathuoclongchau.com.vn/bai-viet/huong-dan-cach-phong-ngua-benh-tieu-duong.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K07", `topic`: "Dinh dưỡng", `title`: "Chọn thực phẩm khi mắc đái tháo đường", `text`: "Có thể ưu tiên rau, thực phẩm giàu chất xơ, cá hoặc thịt nạc; điều chỉnh lượng tinh bột thay vì bỏ hẳn nhóm này. Khẩu phần cụ thể còn phụ thuộc sức khỏe và nhu cầu mỗi người.", `keys`: "chế độ ăn ăn gì tinh bột thực đơn dinh dưỡng ăn uống lành mạnh", `url`: "https://nhathuoclongchau.com.vn/bai-viet/cach-xay-dung-che-do-an-cho-nguoi-tieu-duong.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K08", `topic`: "Dinh dưỡng", `title`: "Hạn chế đồ uống có đường", `text`: "Hạn chế đồ uống nhiều đường là một cách giảm lượng đường thêm vào trong chế độ ăn. Có thể chọn nước lọc hoặc đồ uống không đường.", `keys`: "đồ uống nước lọc nước ngọt trà sữa", `url`: "https://nhathuoclongchau.com.vn/bai-viet/huong-dan-cach-phong-ngua-benh-tieu-duong.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K09", `topic`: "Theo dõi", `title`: "Ghi rõ thời điểm đo glucose", `text`: "Khi ghi kết quả đường huyết, hãy ghi thêm thời điểm đo và có nhịn ăn hay không. Chỉ số lúc đói và sau ăn có cách diễn giải khác nhau.", `keys`: "theo dõi đường huyết thời điểm đo sau ăn ghi lại", `url`: "https://nhathuoclongchau.com.vn/bai-viet/huong-dan-cach-doc-chi-so-duong-huyet-chinh-xac-va-don-gian-nhat.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K10", `topic`: "Vận động", `title`: "Vai trò của vận động trong quản lý típ 2", `text`: "Hoạt động thể lực phù hợp giúp hỗ trợ kiểm soát đường huyết ở người mắc típ 2. Nếu có biến chứng hoặc đang dùng thuốc ảnh hưởng đường huyết, hãy hỏi nhân viên y tế về cách tập phù hợp.", `keys`: "tập thể dục khi bị tiểu đường luyện tập", `url`: "https://nhathuoclongchau.com.vn/benh/tieu-duong-tuyp-2.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K11", `topic`: "Xét nghiệm", `title`: "Tiền đái tháo đường là gì?", `text`: "Tiền đái tháo đường là tình trạng đường huyết cao hơn bình thường nhưng chưa đến ngưỡng đái tháo đường. Nhân viên y tế có thể dùng HbA1c, glucose lúc đói hoặc OGTT để đánh giá.", `keys`: "tiền tiểu đường tiền đái tháo đường tiền đái", `url`: "https://nhathuoclongchau.com.vn/bai-viet/chi-so-duong-huyet-tien-tieu-duong-la-bao-nhieu.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K12", `topic`: "Theo dõi", `title`: "Nhận biết hạ đường huyết", `text`: "Hạ đường huyết là tình trạng glucose trong máu giảm thấp. Các dấu hiệu có thể gồm vã mồ hôi, hồi hộp hoặc chóng mặt. Nếu người bệnh bất tỉnh, cần gọi cấp cứu.", `keys`: "hạ đường huyết tụt đường vã mồ hôi hồi hộp", `url`: "https://nhathuoclongchau.com.vn/benh/ha-duong-huyet-294.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K13", `topic`: "Theo dõi", `title`: "Biến chứng đái tháo đường", `text`: "Đái tháo đường có thể ảnh hưởng đến mắt, thận, thần kinh và tim mạch. Theo dõi định kỳ giúp phát hiện vấn đề sớm.", `keys`: "biến chứng tổn thương thận võng mạc tổn thương thần kinh", `url`: "https://nhathuoclongchau.com.vn/bai-viet/6-bien-chung-benh-tieu-duong-thuong-gap-va-cach-phong-ngua.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K14", `topic`: "Theo dõi", `title`: "Hút thuốc và đái tháo đường", `text`: "Hút thuốc có liên quan đến nguy cơ đái tháo đường típ 2 và có thể làm việc kiểm soát bệnh khó hơn. Có thể hỏi cơ sở y tế về hỗ trợ cai thuốc.", `keys`: "hút thuốc thuốc lá cai thuốc", `url`: "https://nhathuoclongchau.com.vn/bai-viet/benh-tieu-duong-co-lien-quan-den-hut-thuoc-la-khong-50643.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K15", `topic`: "Theo dõi", `title`: "Béo phì và kháng insulin", `text`: "Thừa cân hoặc béo phì có liên quan đến kháng insulin và nguy cơ đái tháo đường típ 2. BMI chỉ là một thông tin để đánh giá cùng các yếu tố khác.", `keys`: "béo phì bmi kháng insulin thừa cân", `url`: "https://nhathuoclongchau.com.vn/bai-viet/khang-insulin-va-beo-phi-co-moi-lien-he-gi-doi-tuong-nao-de-mac-tieu-duong-do-beo-phi.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K16", `topic`: "Theo dõi", `title`: "Tìm hiểu đái tháo đường típ 1", `text`: "Trong đái tháo đường típ 1, cơ thể sản xuất rất ít hoặc không sản xuất đủ insulin. Người bệnh cần được bác sĩ theo dõi và điều trị bằng insulin theo chỉ định.", `keys`: "típ 1 tuýp 1 type 1", `url`: "https://nhathuoclongchau.com.vn/benh/tieu-duong-tuyp-1.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K17", `topic`: "Theo dõi", `title`: "Tìm hiểu đái tháo đường típ 2", `text`: "Trong đái tháo đường típ 2, cơ thể đáp ứng kém với insulin hoặc không sản xuất đủ insulin để giữ đường huyết trong mức phù hợp.", `keys`: "típ 2 tuýp 2 type 2", `url`: "https://nhathuoclongchau.com.vn/benh/tieu-duong-tuyp-2.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K18", `topic`: "Thuốc", `title`: "Thông tin chung về metformin", `text`: "Metformin là thuốc kê đơn được dùng trong điều trị đái tháo đường típ 2. Việc chọn thuốc và điều chỉnh điều trị cần do nhân viên y tế quyết định.", `keys`: "metformin thuốc metformin", `url`: "https://nhathuoclongchau.com.vn/thuoc/metformin-1000mg-stella-6x10-30260.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K19", `topic`: "Thuốc", `title`: "Thông tin chung về gliclazide", `text`: "Gliclazide là thuốc kê đơn dùng trong điều trị đái tháo đường típ 2. Thuốc có thể gây hạ đường huyết; không tự thay đổi cách dùng.", `keys`: "gliclazide dorocron", `url`: "https://nhathuoclongchau.com.vn/thuoc/dorocron-mr-30mg-domesco-2x30-20167.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K20", `topic`: "Thuốc", `title`: "Thông tin chung về dapagliflozin", `text`: "Dapagliflozin là thuốc kê đơn thuộc nhóm ức chế SGLT2. Chỉ định tùy bệnh lý và đánh giá của bác sĩ.", `keys`: "dapagliflozin forxiga sglt2", `url`: "https://nhathuoclongchau.com.vn/thuoc/forxiga-10mg-3713.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K21", `topic`: "Theo dõi", `title`: "Các yếu tố nguy cơ thường gặp", `text`: "Tuổi, tiền sử gia đình, ít vận động và thừa cân là các thông tin có thể liên quan đến nguy cơ đái tháo đường típ 2. Một yếu tố riêng lẻ không đủ để kết luận.", `keys`: "yếu tố nguy cơ tiền sử gia đình di truyền", `url`: "https://nhathuoclongchau.com.vn/bai-viet/dai-thao-duong-la-gi-nhung-yeu-to-nguy-co-dai-thao-duong-ma-ban-nen-biet.html", `source`: "Nhà thuốc FPT Long Châu"}, {`id`: "K22", `topic`: "Xét nghiệm", `title`: "Ngưỡng HbA1c tham khảo", `text`: "CDC nêu HbA1c dưới 5,7% thuộc mức bình thường, 5,7–6,4% thuộc tiền đái tháo đường và từ 6,5% thuộc ngưỡng đái tháo đường. Kết quả cá nhân cần nhân viên y tế đánh giá và xác nhận.", `keys`: "ngưỡng hba1c a1c 6.5 tiền đái tháo đường", `url`: "https://www.cdc.gov/diabetes/diabetes-testing/index.html", `source`: "CDC"}, {`id`: "K23", `topic`: "Xét nghiệm", `title`: "Ngưỡng glucose phụ thuộc thời điểm đo", `text`: "CDC nêu glucose lúc đói từ 126 mg/dL và glucose bất kỳ từ 200 mg/dL thuộc ngưỡng tham khảo đái tháo đường. Cần biết thời điểm đo và được nhân viên y tế xác nhận. Dataset không ghi thời điểm đo glucose.", `keys`: "ngưỡng glucose lúc đói bất kỳ thời điểm đo đường huyết", `url`: "https://www.cdc.gov/diabetes/diabetes-testing/index.html", `source`: "CDC"}] AS row
MERGE (p:P1Passage {id: row.id})
SET p.title=row.title, p.text=row.text, p.keys=row.keys
MERGE (t:P1Topic {name: row.topic})
MERGE (s:P1Source {url: row.url})
SET s.name=row.source
MERGE (p)-[:ABOUT]->(t)
MERGE (p)-[:FROM_SOURCE]->(s);

UNWIND [{`id`: "K01", `head`: "Nhiễm toan ceton", `relation`: "Dấu hiệu cảnh báo", `tail`: "Khó thở hoặc nôn liên tục", `aliases`: ["nhiem toan ceton", "hoi tho mui trai cay", "nhiem toan", "dka"]}, {`id`: "K02", `head`: "Đánh giá đường huyết", `relation`: "Xét nghiệm", `tail`: "HbA1c", `aliases`: ["hba1c", "a1c", "hemoglobin glycat"]}, {`id`: "K03", `head`: "Đánh giá đường huyết", `relation`: "Xét nghiệm", `tail`: "OGTT", `aliases`: ["ogtt", "nghiem phap dung nap duong", "dung nap glucose", "duong huyet hai gio"]}, {`id`: "K04", `head`: "Đánh giá đường huyết", `relation`: "Xét nghiệm", `tail`: "Glucose lúc đói", `aliases`: ["duong huyet luc doi", "glucose luc doi", "nhin an"]}, {`id`: "K05", `head`: "Đái tháo đường", `relation`: "Triệu chứng", `tail`: "Khát nhiều, tiểu nhiều, nhìn mờ", `aliases`: ["trieu chung", "tieu nhieu", "khat nhieu", "nhin mo"]}, {`id`: "K06", `head`: "Phòng ngừa típ 2", `relation`: "Hoạt động", `tail`: "Vận động thể lực", `aliases`: ["van dong", "di bo", "hoat dong the luc", "tap the duc"]}, {`id`: "K07", `head`: "Dinh dưỡng", `relation`: "Lựa chọn", `tail`: "Thực phẩm giàu chất xơ", `aliases`: ["che do an", "an gi", "tinh bot", "thuc don", "dinh duong", "an uong lanh manh"]}, {`id`: "K08", `head`: "Dinh dưỡng", `relation`: "Đồ uống", `tail`: "Nước lọc", `aliases`: ["do uong", "nuoc loc", "nuoc ngot", "tra sua"]}, {`id`: "K09", `head`: "Theo dõi", `relation`: "Ghi nhận", `tail`: "Thời điểm đo glucose", `aliases`: ["theo doi duong huyet", "thoi diem do", "sau an", "ghi lai"]}, {`id`: "K10", `head`: "Đái tháo đường típ 2", `relation`: "Hỗ trợ", `tail`: "Hoạt động thể lực", `aliases`: ["tap the duc khi bi tieu duong", "luyen tap"]}, {`id`: "K11", `head`: "Đái tháo đường típ 2", `relation`: "Tình trạng liên quan", `tail`: "Tiền đái tháo đường", `aliases`: ["tien tieu duong", "tien dai thao duong", "tien dai"]}, {`id`: "K12", `head`: "Hạ đường huyết", `relation`: "Triệu chứng", `tail`: "Vã mồ hôi, hồi hộp, chóng mặt", `aliases`: ["ha duong huyet", "tut duong", "va mo hoi", "hoi hop"]}, {`id`: "K13", `head`: "Đái tháo đường", `relation`: "Biến chứng", `tail`: "Mắt, thận, thần kinh và tim mạch", `aliases`: ["bien chung", "ton thuong than", "vong mac", "ton thuong than kinh"]}, {`id`: "K14", `head`: "Đái tháo đường típ 2", `relation`: "Yếu tố nguy cơ", `tail`: "Hút thuốc", `aliases`: ["hut thuoc", "thuoc la", "cai thuoc"]}, {`id`: "K15", `head`: "Đái tháo đường típ 2", `relation`: "Yếu tố nguy cơ", `tail`: "Béo phì và kháng insulin", `aliases`: ["beo phi", "bmi", "khang insulin", "thua can"]}, {`id`: "K16", `head`: "Đái tháo đường", `relation`: "Phân loại", `tail`: "Đái tháo đường típ 1", `aliases`: ["tip 1", "tuyp 1", "type 1"]}, {`id`: "K17", `head`: "Đái tháo đường", `relation`: "Phân loại", `tail`: "Đái tháo đường típ 2", `aliases`: ["tip 2", "tuyp 2", "type 2"]}, {`id`: "K18", `head`: "Metformin", `relation`: "Nhóm sử dụng", `tail`: "Điều trị đái tháo đường típ 2", `aliases`: ["metformin", "thuoc metformin"]}, {`id`: "K19", `head`: "Gliclazide", `relation`: "Lưu ý", `tail`: "Nguy cơ hạ đường huyết", `aliases`: ["gliclazide", "dorocron"]}, {`id`: "K20", `head`: "Dapagliflozin", `relation`: "Phân nhóm", `tail`: "Ức chế SGLT2", `aliases`: ["dapagliflozin", "forxiga", "sglt2"]}, {`id`: "K21", `head`: "Đái tháo đường típ 2", `relation`: "Yếu tố nguy cơ", `tail`: "Tuổi, gia đình và ít vận động", `aliases`: ["yeu to nguy co", "tien su gia dinh", "di truyen"]}, {`id`: "K22", `head`: "HbA1c", `relation`: "Ngưỡng tham khảo", `tail`: "HbA1c từ 6,5%", `aliases`: ["nguong hba1c", "hba1c cao", "chi so hba1c"]}, {`id`: "K23", `head`: "Glucose", `relation`: "Ngưỡng theo thời điểm", `tail`: "Lúc đói hoặc bất kỳ", `aliases`: ["nguong glucose", "glucose luc doi", "glucose bat ky"]}] AS row
MATCH (p:P1Passage {id: row.id})
MERGE (head:P1Concept {name: row.head})
MERGE (tail:P1Concept {name: row.tail})
MERGE (head)-[r:KNOWLEDGE_LINK {evidence_id: row.id}]->(tail)
SET r.kind=row.relation, r.aliases=row.aliases
MERGE (tail)-[:SUPPORTED_BY]->(p);
